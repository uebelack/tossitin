{
  "name": "tossitin",
  "version": "2.1.0",
  "description": "Generate git commit messages using a LangGraph workflow that inspects repo state and commits changes",
  "keywords": [
    "ai",
    "anthropic",
    "automation",
    "claude",
    "commit",
    "git",
    "langchain"
  ],
  "license": "MIT",
  "author": "David Übelacker",
  "repository": {
    "type": "git",
    "url": "https://github.com/uebelack/tossitin"
  },
  "bin": "./index.mjs",
  "type": "module",
  "main": "index.mjs",
  "scripts": {
    "lint:check": "oxlint",
    "lint:fix": "oxlint --fix",
    "format:check": "oxfmt --check .",
    "format:write": "oxfmt .",
    "test": "vitest run"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "@langchain/anthropic": "^1.5.2",
    "@langchain/core": "^1.2.4",
    "@langchain/ollama": "^1.3.0",
    "execa": "^9.6.1",
    "langchain": "^1.5.4",
    "yargs": "^18.1.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@vitest/coverage-istanbul": "^4.1.10",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.9.0"
}
