{
  "name": "tossitin",
  "version": "2.1.0",
  "description": "Generate git commit messages using a LangGraph workflow that inspects repo state and commits changes",
  "keywords": [
    "ai",
    "anthropic",
    "automation",
    "claude",
    "commit",
    "git",
    "langchain"
  ],
  "license": "MIT",
  "author": "David Übelacker",
  "repository": {
    "type": "git",
    "url": "https://github.com/uebelack/tossitin"
  },
  "bin": "./index.mjs",
  "type": "module",
  "main": "index.mjs",
  "scripts": {
    "lint:check": "oxlint",
    "lint:fix": "oxlint --fix",
    "format:check": "oxfmt --check .",
    "format:write": "oxfmt .",
    "test": "vitest run"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "@langchain/anthropic": "^1.6.4",
    "@langchain/core": "^1.4.0",
    "@langchain/ollama": "^1.3.0",
    "execa": "^9.6.1",
    "langchain": "^1.6.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@vitest/coverage-istanbul": "^4.1.12",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.93.0",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.9.0"
}
