{
  "name": "tossitin",
  "version": "2.1.0",
  "description": "Generate git commit messages using a LangGraph workflow that inspects repo state and commits changes",
  "keywords": [
    "ai",
    "anthropic",
    "automation",
    "claude",
    "commit",
    "git",
    "langchain"
  ],
  "homepage": "https://github.com/uebelack/tossitin#readme",
  "bugs": {
    "url": "https://github.com/uebelack/tossitin/issues"
  },
  "license": "MIT",
  "author": "David Übelacker",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uebelack/tossitin.git"
  },
  "bin": "./index.mjs",
  "files": [
    "index.mjs",
    "src/**/*.mjs",
    "!src/**/*.test.mjs"
  ],
  "type": "module",
  "main": "index.mjs",
  "scripts": {
    "lint:check": "oxlint",
    "lint:fix": "oxlint --fix",
    "format:check": "oxfmt --check .",
    "format:write": "oxfmt .",
    "test": "vitest run"
  },
  "dependencies": {
    "@clack/prompts": "^1.9.0",
    "@langchain/anthropic": "^1.6.4",
    "@langchain/core": "^1.4.0",
    "@langchain/ollama": "^1.3.0",
    "execa": "^10.2.1",
    "langchain": "^1.6.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@vitest/coverage-istanbul": "^5.1.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@12.18.0"
}
